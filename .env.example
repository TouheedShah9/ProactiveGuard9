# ProactiveGuard v2.0 — environment configuration
# Copy this file to .env and fill in your own values.
# .env is gitignored — never commit real API keys.

# Required for Groq-powered LLM explanations (manager/doctor/engineer
# audience views). Get a free key at https://console.groq.com/keys
# Without this, the app runs fully functional in offline rule-based
# explanation mode — no feature is lost, just the LLM-generated prose.
GROQ_API_KEY=your_groq_api_key_here

# Model name on Groq. Groq periodically deprecates older model names —
# if you get a "model_decommissioned" error, check
# https://console.groq.com/docs/deprecations for the current
# recommended replacement.
GROQ_MODEL=openai/gpt-oss-20b
